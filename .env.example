# ========================================================
# DENTAMAROC - CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# Compatible Vercel + Neon / Supabase + Supabase Storage
# ========================================================

# 1. Base de données PostgreSQL (Prisma avec Connection Pooling pour Serverless Vercel)
# Format Neon / Supabase Pooled connection (pgBouncer port 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST-POOLER].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe pour les migrations Prisma (Port 5432 direct)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST-DIRECT].supabase.com:5432/postgres"

# 2. NextAuth.js / Auth.js (Authentification & Sécurité RBAC)
NEXTAUTH_SECRET="votre_super_secret_aleatoire_genere_avec_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"
# En production sur Vercel : NEXTAUTH_URL="https://votre-cabinet.vercel.app"

# 3. Stockage Cloud Supabase (Radiographies, Photos, Justificatifs)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_STORAGE_BUCKET="dental-records"

# 4. Paramètres du Cabinet (Optionnel - modifiable dans l'UI)
NEXT_PUBLIC_CABINET_NAME="Cabinet Dentaire Dr. Mehdi Alami"
NEXT_PUBLIC_CABINET_CITY="Casablanca"
NEXT_PUBLIC_CABINET_CURRENCY="MAD"
